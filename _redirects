# ── DC special case: not pre-rendered, served by index.html ──
/state/district-of-columbia  /index.html  200

# ── State + rep deep-links → pre-rendered HTML ──
# A single splat rule serves both:
#   /state/<slug>                          → /states/<slug>.html
#   /state/<slug>/district-<n>/<rep-slug>  → /states/<slug>/district-<n>/<rep-slug>.html
# Filename on disk always ends with ".html"; splat captures everything
# after /state/ (one level or three) and we append .html.
/state/*  /states/:splat.html  200

